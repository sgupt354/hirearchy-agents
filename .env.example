# Copy to .env.local for local dev, or set these in Vercel. Never commit real values.

# --- Server-side (Vercel functions in api/) ---
# api/voice.ts: Claude wording for phone messages. Optional; without it messages use the fallback text.
ANTHROPIC_API_KEY=
# api/notify.ts: Discord webhook for Aditya's "needs you" notifications. Optional; skipped when unset.
DISCORD_WEBHOOK_URL=

# Live Discord mode (see LIVE_DISCORD.md). Server-side only: never prefix these with VITE_.
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_ADITYA_USER_ID=
DISCORD_USER_ADITYA=
DISCORD_USER_SUMIT=
DISCORD_USER_MAYA=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Client-side (baked into the build) ---
# true = phone messages worded by Claude via /api/voice. Default (false/unset) = built-in student copy.
VITE_USE_LLM_COPY=false

# --- Not used by the app yet (supabase/track2.sql is written but not wired) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Apply suite (server-side only; never prefix with VITE_)
APOLLO_API_KEY=
OUTREACH_MODEL=
JOBS_SEARCH=
